#!/bin/sh
# holding <command>: local helper for agents-holding customers.
src="$0"  # follow symlinks (e.g. ~/.local/bin/holding -> ~/.agents-holding/scripts/holding)
while [ -L "$src" ]; do d="$(dirname "$src")"; src="$(readlink "$src")"; case "$src" in /*) ;; *) src="$d/$src" ;; esac; done
here="$(cd "$(dirname "$src")" && pwd)"
case "$1" in
  listen) shift; exec node "$here/holding-listen.mjs" "$@" ;;
  listener) shift; exec bash "$here/launchd/listener.sh" "$@" ;;
  doctor) shift; exec bash "$here/doctor.sh" "$@" ;;
  jira-keychain) shift; exec bash "$here/jira-keychain-setup.sh" "$@" ;;
  jira-workflow) shift; exec bash "$here/jira-setup-workflow.sh" "$@" ;;
  jira-webhook) shift; exec bash "$here/jira-register-webhook.sh" "$@" ;;
  add-project) shift; exec node "$here/projects.mjs" add "$@" ;;
  remove-project) shift; exec node "$here/projects.mjs" remove "$@" ;;
  projects) shift; exec node "$here/projects.mjs" list "$@" ;;
  status) shift; exec node "$here/status.mjs" status "$@" ;;
  notify) shift; exec node "$here/status.mjs" notify "$@" ;;
  habits) shift; exec node "$here/habits.mjs" "$@" ;;
  agent) shift; exec node "$here/agent-cli.mjs" "$@" ;;
  sync-commands) shift; exec bash "$here/sync-commands.sh" "$@" ;;
  open-setup) shift; exec bash "$here/open-setup.sh" "$@" ;;
  staffs|whoami|usage|tasks|history|sources|renew|plan|hire|fire|assign|convention|auto-pr|flow|custom-skills|help|tokens|token-add|token-revoke|token-renew|token-label|token-reset-device)
    exec bash "$here/ah-cli.sh" "$@" ;;
  server) shift; exec bash "$here/ah-cli.sh" "$@" ;;
  jira-tasks|jira-task|jira-board|jira-new|jira-move|jira-comment) exec node "$here/jira.mjs" "$@" ;;
  *) cat <<USAGE
usage:
  holding listener on [--repo DIR]   start the background listener now
  holding listener off               stop it AND turn auto-start off
  holding listener autostart on|off  start at login (only while the listener is on)
  holding listener status            running? PID, autostart, last 'join ok'
  holding listener logs [-f]         recent listener log
  holding doctor [--repo DIR]        check every local setup step
  holding listen [--repo DIR] [--once]   run the listener in the foreground (all registered projects, or only DIR)
  holding jira-keychain <site> <email>     store your Atlassian API token in the macOS Keychain (hidden prompt)
  holding jira-workflow <site> <email> <KEY> [--dry-run]   create missing Jira statuses/columns
  holding jira-webhook '<setup_url>'      register the Jira webhook (token from the Keychain)
  holding add-project --jira-project KEY [--jira-project KEY2] [--company ID] [--name N] [--auto-pr on|off] [--agent A]   (inside a repo)
  holding remove-project [--repo DIR|NAME] [--jira-project KEY]
  holding projects [--json]           list repos and the Jira boards feeding them
  holding agent [grok|claude|codex] [--model M] [--text-model M]   CLI the listener runs for this company (no args = show)
  holding status                     listener alive?, realtime, last webhook event, last heartbeat, current task/stage
  holding notify on|off              macOS notifications for agent start/done/fail (default on)
  holding habits [show|edit|clear]    user habits learned on Done (local; used in plan/tech plan/code prompts)
  holding staffs|whoami|usage|tasks|history|sources|plan KEY|flow|help ...   instant server commands, no model (holding help)
  holding server doctor|status|listener   server-side view of /doctor, /listener
  holding tokens|token-add|token-revoke|token-renew|token-label|token-reset-device   owner key commands
  holding jira-tasks [column] | jira-task KEY | jira-board | jira-new "title" [desc] | jira-move KEY <col> | jira-comment KEY "text"  [--project KEY]
  holding sync-commands [--owner] [--claude]   refresh Grok slash commands (~/.grok/commands) from the server
  holding open-setup '<setup_url>'        open the /connect-jira setup page
USAGE
     exit 2 ;;
esac
