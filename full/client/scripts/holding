#!/usr/bin/env bash
# holding <noun> <verb> [args]: local helper for agents-holding customers. One root, `holding <noun> <verb>`; chat slash
# commands map 1:1 (`/staff add` = `holding staff add`). No verb = list/show. Unknown command = this help.
src="$0"  # follow symlinks (e.g. ~/.local/bin/holding -> ~/.agents-holding/scripts/holding)
while [ -L "$src" ]; do d="$(dirname "$src")"; src="$(readlink "$src")"; case "$src" in /*) ;; *) src="$d/$src" ;; esac; done
here="$(cd "$(dirname "$src")" && pwd)"
# @company mention -> --company <company> (exact local company only; other @words stay as text)
isco() { [ -d "$HOME/.config/agents-holding/state/$1" ] || grep -q "\"company\": *\"$1\"" "$HOME/.config/agents-holding/projects.json" 2>/dev/null; }
n=$#; i=0; while [ $i -lt $n ]; do x="$1"; shift; i=$((i+1)); case "$x" in @?*) if isco "${x#@}"; then set -- "$@" --company "${x#@}"; else set -- "$@" "$x"; fi ;; *) set -- "$@" "$x" ;; esac; done
usage() { cat <<'USAGE'
usage: holding <noun> <verb> [args]   (chat: /<noun> <verb> ...; no verb = list/show)
  jira attach <KEY> <file...> | figma connect [--switch] | figma status | figma logout | figma export <url> [--out f.png] [--attach KEY] | atlassian connect [--switch] | atlassian status | atlassian logout | confluence page create|update <SPACE> "<title>" --file md [--attach png]
  codegraph list|detect|status|use <name>|clear   code-graph backend (per company; auto-detect + prism fallback)
  dependency add|list|update|remove <link>   skill-pack git deps (~/.agents-holding/packs; company stores a reference only)
  update            update the client: scripts, agent configs + sandbox profiles, slash commands, restart the Jira Listener (safe to rerun; chat: /holding update)
  skill private <name> | skill public <name>   set custom skill visibility (new skills default public)
  role private <name> | role public <name>     private roles never sync (process steps → private-role-<hash>)
  process private <name> | process public <name>  private processes stay local; public structure may sync
  process library                               [owner] browse aggregated process structures (zero token)
  help [group|command]                the commands YOUR key can run (aliases: document, docs)
  staff list | add <role> [--agent P --model M --effort E] | remove <role>   (add: review the staff policy, arrow-key menu)
  staff policy show <staff|*> | set <staff|*> <permission> on|off | rule add|remove <staff|*> "<text>" | git set|unset <staff|*> <field> <value>
  staff policy shell allow|deny|remove <staff|*> "<cmd>" | check <staff> branch|commit|pr|push <value> | sync [staff] | native <staff>
  staff deny add|remove <staff> <path> [--replace <file>] | staff deny list <staff>      (per staff; cannot remove a company deny)
  company deny add|remove <path> [--replace <file>] | company deny list                  (all staff of the company)
  company process templates | list | setup | add --template <T> --from <SRC> [--to P1,P2] [--status S] [--link-type T] | add-json '<json>' | remove <id>
  process rule add --template parent-auto-done --project KEY [--exclude-epics] [--enable] | list | remove <id> | test <id> [--issue KEY]
  staff set <staff> <provider> <model> [low|medium|high] | set <staff> "<command with {prompt}>" | unset <staff>   [--company X]
  staff run <staff> "<task>" [--proceed] | staff test <staff> | staff presets   (headless sub-agent runners, local LLMs too)
  staff add <role> --preset <id> [--model M]   attach a headless runner (no chat window)
  task list [all] | history [n] | plan <KEY> | set <KEY> --staff <role> | add "<description>" | split <KEY>   (add/split: in your agent)
  provider list | set [staff ...] [--agent P --model M --effort E] | set --default <role> <provider> [model] [effort] | unset <role>
  skill add <staff> <skill> | skill remove <staff> <skill> | skill list [--custom]
  skill where|check|set <name> public|private|sync [--dry-run]|consent <name>|run <name> <script>
  project add --jira-project KEY [--company ID] [--name N] [--auto-pr on|off] [--agent A] | remove [--repo DIR|NAME] [--jira-project KEY] | list [--json]
  company list | count | overview | show [company] | use <company>   (only companies connected to holding)
  company create [name] [--parent P]   (name optional = this folder; also: holding create company [name]) | rename <c> <name> | pause|resume|archive <c> | delete <c> --confirm <c> | move <c> --parent <P|none>
  company staff move <role> <from> <to> | staff assign <role> <c> | link <c> <KEY> | unlink <c> | config [c] [set|unset <key> <value>] | config defaults
  company migrate <local company folder> [--parent P] [--dry-run]   (bring an older local company into holding; originals kept)
  company set lang <code|auto> | communication [jira+chat|chat] | auto-pr on|off | convention "<text>" | agent [grok|claude|codex] [--model M]
  listener start [--repo DIR] | restart [--repo DIR] | stop | status [--server] | logs [-f] | autostart on|off | run [--repo DIR] [--once]
  jira connect [--switch] | status | logout   (OAuth in Keychain; legacy: jira connect <site> <email>) | setup-workflow <site> <email> <KEY> [--dry-run] | connect-events '<setup_url>' | sources
  jira list [column] | show KEY | board | add "title" [desc] | move KEY <column> | comment KEY "text" | edit KEY [--description-file FILE] [--label-add L] [--label-remove L] [--assignee ACCOUNT_ID] [--fields-json JSON]   [--project KEY] | listen
  inbox list [--all] [KEY] | inbox reply <KEY|item> <answer> | inbox dismiss <item|KEY>
  ceo [--item <id|KEY>]               the CEO is your chat session (/ceo); --item opens one focused on a pending item
  key show | generate | import        your key id, plan, credits, devices (generate: new Free key; import: use an existing key on this Mac)
  credit show                         your credits
  billing [vi|en] | billing usage [days]
  usage [--by day|staff] [--key ref]   plan + credits bar this period (own key; owner: --key)
  status [--server] | doctor [--repo DIR] [--server] | notify on|off
  setup sync [--owner] [--claude] | setup open '<setup_url>'
  habit list | edit | clear
  flow show | list                    (edit a flow with /flow edit in your agent)
  --all (status, task list, task history, jira list, jira board, billing usage, staff list): every local company
USAGE
exit 2; }
noun="${1:-}"; verb="${2:-}"; [ $# -gt 0 ] && shift; [ $# -gt 0 ] && shift
# deny add|remove|list <scope> [path] [--replace FILE]: scope * = company-wide, else one staff. Replacement files are scanned for real secrets first.
denycmd() { local v="$1" sc="$2"; shift 2; local a=() rep="" force=""; while [ $# -gt 0 ]; do case "$1" in --replace) rep="$2"; a+=("--replace" "$2"); shift 2 ;; --force) force=1; shift ;; *) a+=("$1"); shift ;; esac; done
  [ "$v" = list ] && exec bash "$here/ah-cli.sh" staff policy deny list "$sc" "${a[@]+"${a[@]}"}"
  if [ -n "$rep" ]; then [ -f "$rep" ] || { echo "replacement file not found: $rep" >&2; exit 2; }
    node "$here/policy.mjs" scan "$rep" || { [ -n "$force" ] || { echo "refusing: put fake placeholder values in $rep (or add --force)" >&2; exit 1; }; }; fi
  bash "$here/ah-cli.sh" staff policy deny "$v" "$sc" "${a[@]+"${a[@]}"}" || exit $?; bash "$here/install-permission-listener.sh" >/dev/null 2>&1 || true; node "$here/policy.mjs" sync "$sc" >/dev/null 2>&1 || true; exit 0; }
srv() { exec bash "$here/ah-cli.sh" "$noun" "$verb" "$@"; }  # server-rendered text (ah-cli.sh): command=<noun>, args=<verb ...>
case " $* " in *" --all "*) case "$noun $verb" in "status "|"status --all"|"task list"|"task history"|"jira list"|"jira board"|"billing usage"|"staff list") exec node "$here/all-cli.mjs" "$noun" "$verb" "$@" ;; esac ;; esac
case "$noun" in update|upgrade|help|document|docs|-h|--help) ;; *) [ "${AH_NO_UPDATE_CHECK:-}" = 1 ] || [ "${AH_HOOK_RUN:-}" = 1 ] || bash "$here/update.sh" --check 2>/dev/null </dev/tty || true ;; esac
case "$noun" in
  terminal) exec node "$here/terminal.mjs" "$verb" "$@" ;;
  update|upgrade) exec bash "$here/update.sh" ${verb:+"$verb"} "$@" ;;
  uninstall) exec bash "$here/uninstall-local.sh" ${verb:+"$verb"} "$@" ;;
  codegraph|code-graph) case "${verb:-status}" in
    ""|list|detect|status|resolve|use|clear|help) exec node "$here/codegraph.mjs" "${verb:-status}" "$@" ;;
    *) exec node "$here/codegraph.mjs" "$verb" "$@" ;; esac ;;
  dependency) case "${verb:-list}" in
    ""|add|list|update|remove|consent|run|expose|help) exec node "$here/dependency.mjs" "${verb:-list}" "$@" ;;
    *) exec node "$here/dependency.mjs" "$verb" "$@" ;; esac ;;
  figma) case "$verb" in connect) exec node "$here/attach.mjs" figma-connect "$@" ;; status) exec node "$here/attach.mjs" figma-status ;; logout) exec node "$here/attach.mjs" figma-logout ;; export) exec node "$here/attach.mjs" figma-export "$@" ;; *) usage ;; esac ;;
  atlassian) case "$verb" in connect) exec node "$here/attach.mjs" atlassian-connect "$@" ;; status) exec node "$here/attach.mjs" atlassian-status ;; logout) exec node "$here/attach.mjs" atlassian-logout ;; *) usage ;; esac ;;
  confluence) case "$verb" in page) exec node "$here/attach.mjs" confluence-page "$@" ;; *) usage ;; esac ;;
  help|document|docs) exec node "$here/help.mjs" ${verb:+"$verb"} "$@" ;;
  -h|--help) echo "Run: holding help   (commands available for your key; holding help <group|command> for details)"; exec node "$here/help.mjs" ;;
  staff) case "$verb" in
    ""|list) set +e; out="$(bash "$here/ah-cli.sh" staff list "$@")"; rc=$?; printf '%s\n' "$out" | node "$here/staffs-local.mjs" "${AH_COMPANY:-}" "$@"; exit $rc ;;
    add) role="${1:-}"; bind=(); rest=(); while [ $# -gt 0 ]; do case "$1" in --agent|--provider|--model|--effort|--command|--preset) bind+=("$1" "$2"); shift 2 ;; *) rest+=("$1"); shift ;; esac; done
      bash "$here/ah-cli.sh" staff add ${rest[@]+"${rest[@]}"} || exit $?; node "$here/bind-cli.mjs" "$role" ${bind[@]+"${bind[@]}"} || exit $?
      exec node "$here/policy.mjs" init "$role" ${AH_COMPANY:+--company "$AH_COMPANY"} ;;  # role defaults + review menu (AH_NONINTERACTIVE=1: defaults)
    policy) case "${1:-}" in sync|native|exec|init) exec node "$here/policy.mjs" "$@" ;; esac
      bash "$here/ah-cli.sh" staff policy "$@" || exit $?; case "${1:-}" in set|rule|git|deny|shell) node "$here/policy.mjs" sync "${2:-*}" >/dev/null 2>&1 || true ;; esac; exit 0 ;;
    deny) dv="${1:-list}"; [ $# -gt 0 ] && shift; denycmd "$dv" "${1:-}" "${@:2}" ;;
    presets) exec node "$here/presets.mjs" "$@" ;;
    remove) srv "$@" ;;
    set|unset) exec node "$here/agent-cli.mjs" "$verb" "$@" ;;
    run) exec node "$here/run-cli.mjs" "$@" ;;
    test) exec node "$here/staff-test.mjs" "$@" ;;
    *) usage ;; esac ;;
  task) case "$verb" in ""|list|history|plan|set) [ -z "$verb" ] && verb=list; srv "$@" ;;
    add|split) echo "/task $verb needs the agent: run it inside grok/claude/codex (e.g. /task $verb ...)." >&2; exit 2 ;;
    *) usage ;; esac ;;
  provider) case "$verb" in
    ""|list) node "$here/providers-cli.mjs" "$@"; echo; exec node "$here/bind-cli.mjs" remembered ;;
    set) if [ "${1:-}" = --default ]; then shift; exec node "$here/bind-cli.mjs" remembered set "$@"; fi; exec node "$here/bind-cli.mjs" "$@" ;;
    unset) exec node "$here/bind-cli.mjs" remembered unset "$@" ;;
    *) usage ;; esac ;;
  role) case "$verb" in
    private|public) co="${AH_COMPANY:-}"; name=""; for a in "$@"; do case "$a" in --company) shift;; esac; done
      # args: private|public already consumed as verb; remaining is role name [--company X]
      rname="$1"; shift || true
      while [ $# -gt 0 ]; do case "$1" in --company) co="$2"; shift 2;; *) rname="${rname:-$1}"; shift;; esac; done
      [ -n "$co" ] || { echo "no company: run inside a company repo or pass --company" >&2; exit 2; }
      [ -n "$rname" ] || { echo "usage: holding role private|public <name> [--company X]" >&2; exit 2; }
      exec node "$here/roles.mjs" set "$co" "$rname" "$verb" ;;
    list) co="${AH_COMPANY:-}"; [ -n "$co" ] || { echo "no company" >&2; exit 2; }; exec node "$here/roles.mjs" list "$co" ;;
    *) usage ;; esac ;;
  process) case "$verb" in
    private|public) echo "process $verb: mark local process visibility (structure-only sync when public). See docs/PROCESSES.md"; exit 0 ;;
    library) srv process library "$@" ;;
    *) # fall through to company process for templates/list/setup if routed that way
       case "$verb" in templates|list|setup|add|add-json|remove) exec bash "$0" company process "$verb" "$@" ;;
         rule) exec node "$here/jira-rules.mjs" "$@" ;; esac
       usage ;; esac ;;
  skill) case "$verb" in
    add) exec node "$here/add-skill.mjs" "$@" ;;
    remove) exec node "$here/pack-skills.mjs" remove "$@" ;;
    ""|list) node "$here/pack-skills.mjs" list "$@"; srv list "$@" ;;
    browse|review|variants|library|private|public) srv "$@" ;;
    where|check|set|sync|consent|run) exec node "$here/skills.mjs" "$verb" "$@" ;;
    *) usage ;; esac ;;
  team|enterprise|usage) srv "$@" ;;  # server decides who may run these; everyone else gets the unknown-command help
  project) case "$verb" in
    add) set +e; node "$here/projects.mjs" add "$@" || exit $?
      [ -t 0 ] && node "$here/bind-cli.mjs" $(bash "$here/ah-cli.sh" staff list 2>/dev/null | sed -nE 's/^[^a-z0-9]*([a-z0-9][a-z0-9-]*) - .*/\1/p' | sort -u); exit 0 ;;
    remove) exec node "$here/projects.mjs" remove "$@" ;;
    ""|list) exec node "$here/projects.mjs" list "$@" ;;
    *) usage ;; esac ;;
  create) case "$verb" in company) exec node "$here/company-create.mjs" "$@" ;; *) usage ;; esac ;;  # alias: holding create company [name]
  company) case "$verb" in
    ""|list|count|overview|health) case " $* " in *" --local "*|*" --json "*) exec node "$here/companies-cli.mjs" list "$@" ;; esac; srv "$@" ;;  # MCP companies only
    use) exec node "$here/companies-cli.mjs" use "$@" ;;
    show) case "${1:-}" in convention|auto-pr) srv "$@" ;; "") node "$here/companies-cli.mjs" show; srv "$@" ;; esac; srv "$@" ;;
    create) exec node "$here/company-create.mjs" "$@" ;;
    deny) dv="${1:-list}"; [ $# -gt 0 ] && shift; denycmd "$dv" "*" "$@" ;;
    process) pv="${1:-list}"; [ $# -gt 0 ] && shift; [ "$pv" = setup ] && exec node "$here/policy.mjs" processes "$@"; exec bash "$here/ah-cli.sh" company process "$pv" "$@" ;;
    rename|pause|resume|archive|delete|move|staff|link|unlink|config) srv "$@" ;;
    migrate) exec node "$here/company-migrate.mjs" "$@" ;;
    set) what="${1:-}"; [ $# -gt 0 ] && shift; case "$what" in
        lang) exec node "$here/agent-cli.mjs" lang "$@" ;;
        communication) exec node "$here/inbox-cli.mjs" communication "$@" ;;
        auto-pr|convention) exec bash "$here/ah-cli.sh" company set "$what" "$@" ;;
        agent) exec node "$here/agent-cli.mjs" "$@" ;;
        *) usage ;; esac ;;
    *) usage ;; esac ;;
  listener) case "$verb" in
    run) exec node "$here/holding-listen.mjs" "$@" ;;
    status) case " $* " in *" --server "*) srv "$@" ;; esac; exec bash "$here/launchd/listener.sh" status ;;
    restart) bash "$here/launchd/listener.sh" stop --preserve-autostart; exec bash "$here/launchd/listener.sh" start "$@" ;;
    ""|start|stop|logs|autostart) exec bash "$here/launchd/listener.sh" ${verb:-status} "$@" ;;
    *) usage ;; esac ;;
  jira) case "$verb" in
    listen)
      if bash "$here/launchd/listener.sh" status 2>/dev/null | grep -q 'Jira Listener: ON'; then
        exec bash "$here/launchd/listener.sh" status
      fi
      exec bash "$here/launchd/listener.sh" start "$@" ;;
    attach) exec node "$here/attach.mjs" jira-attach "$@" ;;
    connect)
      # Lazy OAuth (browser). Legacy API-token: holding jira connect <site> <email>
      if [ $# -ge 2 ] && [[ "$1" == http* ]]; then exec bash "$here/jira-keychain-setup.sh" "$@"; fi
      exec node "$here/attach.mjs" jira-connect "$@" ;;
    status) exec node "$here/attach.mjs" jira-status ;;
    account) case "${1:-list}" in
      add|connect) exec node "$here/attach.mjs" atlassian-connect --switch ;;
      list|status|logout) exec node "$here/jira-account.mjs" "${1:-list}" ;;
      *) echo "usage: holding jira account add|list|status|logout" >&2; exit 2;; esac ;;
    logout) exec node "$here/attach.mjs" jira-logout ;;
    setup-workflow) exec bash "$here/jira-setup-workflow.sh" "$@" ;;
    connect-events) exec bash "$here/jira-register-webhook.sh" "$@" ;;
    sources) srv "$@" ;;
    ""|list|show|board|add|move|comment|edit|update) exec node "$here/jira.mjs" "${verb:-list}" "$@" ;;
    setup) echo "/jira setup needs the agent: run it inside grok/claude/codex." >&2; exit 2 ;;
    *) usage ;; esac ;;
  inbox) case "$verb" in ""|list|reply|dismiss) exec node "$here/inbox-cli.mjs" "${verb:-list}" "$@" ;; *) exec node "$here/inbox-cli.mjs" list "$verb" "$@" ;; esac ;;
  ceo) [ -n "$verb" ] && exec node "$here/inbox-cli.mjs" ceo "$verb" "$@"
    echo "The CEO is your current chat session: use /ceo in your agent (Grok/Claude/Codex). Focus one pending item: holding ceo --item <id> (opens a CEO session)."; exit 0 ;;
  # key/credit/whoami are license-level: never require a resolved company (no company: none banner)
  key) case "$verb" in ""|show|generate|import|renew|list|add|remove|set|label|reset-device|rotate|merge|unmerge) srv "$@" ;; *) usage ;; esac ;;
  credit) case "$verb" in ""|show|plans|add|list) srv "$@" ;; *) usage ;; esac ;;
  feedback) srv "$@" ;;
  owner) case "$verb" in recovery-code|recover) srv "$@" ;; *) usage ;; esac ;;
  billing) case "$verb" in ""|usage|vi|en) srv "$@" ;; *) bash "$here/ah-cli.sh" billing "$verb" "$@"; exit $? ;; esac ;;
  status) case " $verb $* " in *" --server "*) exec bash "$here/ah-cli.sh" status ;; esac; exec node "$here/status.mjs" status ${verb:+"$verb"} "$@" ;;
  doctor) case " $verb $* " in *" --server "*) exec bash "$here/ah-cli.sh" doctor ;; esac; exec bash "$here/doctor.sh" ${verb:+"$verb"} "$@" ;;
  notify) case "$verb" in send|list|group) srv "$@" ;; *) exec node "$here/status.mjs" notify ${verb:+"$verb"} "$@" ;; esac ;;
  report) srv "$@" ;;  # report hub: server decides which types/keys the caller may see
  setup) case "$verb" in sync) exec bash "$here/sync-commands.sh" "$@" ;; open) exec bash "$here/open-setup.sh" "$@" ;; *) usage ;; esac ;;
  habit) case "$verb" in ""|list|edit|clear) exec node "$here/habits.mjs" "${verb:-list}" "$@" ;; *) usage ;; esac ;;
  flow) case "$verb" in ""|show|list) srv "$@" ;; *) echo "/flow $verb needs the agent: run it inside grok/claude/codex." >&2; exit 2 ;; esac ;;
  security) srv "$@" ;;  # server decides; non-admins get the same help as an unknown command
  owner) srv "$@" ;;  # owner-only (owner contact show|set); others get the unknown-command help
  *) usage ;;
esac
