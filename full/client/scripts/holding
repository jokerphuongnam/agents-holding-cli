#!/usr/bin/env bash
# holding <noun> <verb> [args]: local helper for agents-holding customers. One root, `holding <noun> <verb>`; chat slash
# commands map 1:1 (`/staff add` = `holding staff add`). No verb = list/show. Unknown command = this help.
src="$0"  # follow symlinks (e.g. ~/.local/bin/holding -> ~/.agents-holding/scripts/holding)
while [ -L "$src" ]; do d="$(dirname "$src")"; src="$(readlink "$src")"; case "$src" in /*) ;; *) src="$d/$src" ;; esac; done
here="$(cd "$(dirname "$src")" && pwd)"
# @company mention -> --company <company> (exact local company only; other @words stay as text)
isco() { [ -d "$HOME/.config/agents-holding/state/$1" ] || grep -q "\"company\": *\"$1\"" "$HOME/.config/agents-holding/projects.json" 2>/dev/null; }
n=$#; i=0; while [ $i -lt $n ]; do x="$1"; shift; i=$((i+1)); case "$x" in @?*) if isco "${x#@}"; then set -- "$@" --company "${x#@}"; else set -- "$@" "$x"; fi ;; *) set -- "$@" "$x" ;; esac; done
usage() { cat <<'USAGE'
usage: holding <noun> <verb> [args]   (chat: /<noun> <verb> ...; no verb = list/show)
  staff list | add <role> [--agent P --model M --effort E] | remove <role>
  staff set <staff> <provider> <model> [low|medium|high] | set <staff> "<command with {prompt}>" | unset <staff>   [--company X]
  staff run <staff> "<task>" [--proceed] | staff test <staff>
  task list [all] | history [n] | plan <KEY> | set <KEY> --staff <role> | add "<description>" | split <KEY>   (add/split: in your agent)
  provider list | set [staff ...] [--agent P --model M --effort E] | set --default <role> <provider> [model] [effort] | unset <role>
  skill add <staff> <skill> | skill list --custom
  project add --jira-project KEY [--company ID] [--name N] [--auto-pr on|off] [--agent A] | remove [--repo DIR|NAME] [--jira-project KEY] | list [--json]
  company list [--json] | use <company> | show [convention|auto-pr]
  company set lang <code|auto> | communication [jira+chat|chat] | auto-pr on|off | convention "<text>" | agent [grok|claude|codex] [--model M]
  listener start [--repo DIR] | stop | status [--server] | logs [-f] | autostart on|off | run [--repo DIR] [--once]
  jira connect <site> <email> | setup-workflow <site> <email> <KEY> [--dry-run] | connect-events '<setup_url>' | sources
  jira list [column] | show KEY | board | add "title" [desc] | move KEY <column> | comment KEY "text"   [--project KEY]
  inbox list [--all] [KEY] | inbox reply <KEY|item> <answer> | inbox dismiss <item|KEY>
  ceo [--item <id|KEY>]               the CEO is your chat session (/ceo); --item opens one focused on a pending item
  key show | generate | import        your key id, plan, credits, devices (generate: new Free key; import: use an existing key on this Mac)
  credit show                         your credits
  billing [vi|en] | billing usage [days]
  status [--server] | doctor [--repo DIR] [--server] | notify on|off
  setup sync [--owner] [--claude] | setup open '<setup_url>'
  habit list | edit | clear
  flow show | list                    (edit a flow with /flow edit in your agent)
  --all (status, task list, task history, jira list, jira board, billing usage, staff list): every local company
USAGE
exit 2; }
noun="${1:-}"; verb="${2:-}"; [ $# -gt 0 ] && shift; [ $# -gt 0 ] && shift
srv() { exec bash "$here/ah-cli.sh" "$noun" "$verb" "$@"; }  # server-rendered text (ah-cli.sh): command=<noun>, args=<verb ...>
case " $* " in *" --all "*) case "$noun $verb" in "status "|"status --all"|"task list"|"task history"|"jira list"|"jira board"|"billing usage"|"staff list") exec node "$here/all-cli.mjs" "$noun" "$verb" "$@" ;; esac ;; esac
case "$noun" in
  staff) case "$verb" in
    ""|list) set +e; out="$(bash "$here/ah-cli.sh" staff list "$@")"; rc=$?; printf '%s\n' "$out" | node "$here/staffs-local.mjs" "${AH_COMPANY:-}" "$@"; exit $rc ;;
    add) role="${1:-}"; bind=(); rest=(); while [ $# -gt 0 ]; do case "$1" in --agent|--provider|--model|--effort|--command) bind+=("$1" "$2"); shift 2 ;; *) rest+=("$1"); shift ;; esac; done
      bash "$here/ah-cli.sh" staff add ${rest[@]+"${rest[@]}"} || exit $?; exec node "$here/bind-cli.mjs" "$role" ${bind[@]+"${bind[@]}"} ;;
    remove) srv "$@" ;;
    set|unset) exec node "$here/agent-cli.mjs" "$verb" "$@" ;;
    run) exec node "$here/run-cli.mjs" "$@" ;;
    test) exec node "$here/staff-test.mjs" "$@" ;;
    *) usage ;; esac ;;
  task) case "$verb" in ""|list|history|plan|set) [ -z "$verb" ] && verb=list; srv "$@" ;;
    add|split) echo "/task $verb needs the agent: run it inside grok/claude/codex (e.g. /task $verb ...)." >&2; exit 2 ;;
    *) usage ;; esac ;;
  provider) case "$verb" in
    ""|list) node "$here/providers-cli.mjs" "$@"; echo; exec node "$here/bind-cli.mjs" remembered ;;
    set) if [ "${1:-}" = --default ]; then shift; exec node "$here/bind-cli.mjs" remembered set "$@"; fi; exec node "$here/bind-cli.mjs" "$@" ;;
    unset) exec node "$here/bind-cli.mjs" remembered unset "$@" ;;
    *) usage ;; esac ;;
  skill) case "$verb" in add) exec node "$here/add-skill.mjs" "$@" ;; ""|list) srv "$@" ;; *) usage ;; esac ;;
  project) case "$verb" in
    add) set +e; node "$here/projects.mjs" add "$@" || exit $?
      [ -t 0 ] && node "$here/bind-cli.mjs" $(bash "$here/ah-cli.sh" staff list 2>/dev/null | sed -nE 's/^[^a-z0-9]*([a-z0-9][a-z0-9-]*) - .*/\1/p' | sort -u); exit 0 ;;
    remove) exec node "$here/projects.mjs" remove "$@" ;;
    ""|list) exec node "$here/projects.mjs" list "$@" ;;
    *) usage ;; esac ;;
  company) case "$verb" in
    ""|list) exec node "$here/companies-cli.mjs" list "$@" ;;
    use) exec node "$here/companies-cli.mjs" use "$@" ;;
    show) case "${1:-}" in convention|auto-pr) srv "$@" ;; esac; exec node "$here/companies-cli.mjs" show "$@" ;;
    set) what="${1:-}"; [ $# -gt 0 ] && shift; case "$what" in
        lang) exec node "$here/agent-cli.mjs" lang "$@" ;;
        communication) exec node "$here/inbox-cli.mjs" communication "$@" ;;
        auto-pr|convention) exec bash "$here/ah-cli.sh" company set "$what" "$@" ;;
        agent) exec node "$here/agent-cli.mjs" "$@" ;;
        *) usage ;; esac ;;
    *) usage ;; esac ;;
  listener) case "$verb" in
    run) exec node "$here/holding-listen.mjs" "$@" ;;
    status) case " $* " in *" --server "*) srv "$@" ;; esac; exec bash "$here/launchd/listener.sh" status ;;
    ""|start|stop|logs|autostart) exec bash "$here/launchd/listener.sh" ${verb:-status} "$@" ;;
    *) usage ;; esac ;;
  jira) case "$verb" in
    connect) exec bash "$here/jira-keychain-setup.sh" "$@" ;;
    setup-workflow) exec bash "$here/jira-setup-workflow.sh" "$@" ;;
    connect-events) exec bash "$here/jira-register-webhook.sh" "$@" ;;
    sources) srv "$@" ;;
    ""|list|show|board|add|move|comment) exec node "$here/jira.mjs" "${verb:-list}" "$@" ;;
    setup) echo "/jira setup needs the agent: run it inside grok/claude/codex." >&2; exit 2 ;;
    *) usage ;; esac ;;
  inbox) case "$verb" in ""|list|reply|dismiss) exec node "$here/inbox-cli.mjs" "${verb:-list}" "$@" ;; *) exec node "$here/inbox-cli.mjs" list "$verb" "$@" ;; esac ;;
  ceo) [ -n "$verb" ] && exec node "$here/inbox-cli.mjs" ceo "$verb" "$@"
    echo "The CEO is your current chat session: use /ceo in your agent (Grok/Claude/Codex). Focus one pending item: holding ceo --item <id> (opens a CEO session)."; exit 0 ;;
  key) case "$verb" in ""|show) [ $# -eq 0 ] && node "$here/companies-cli.mjs" show; srv "$@" ;; generate|import|renew|list|add|remove|set|reset-device|rotate) srv "$@" ;; *) usage ;; esac ;;
  credit) case "$verb" in ""|show|plans|add|list) srv "$@" ;; *) usage ;; esac ;;
  billing) case "$verb" in ""|usage|vi|en) srv "$@" ;; *) bash "$here/ah-cli.sh" billing "$verb" "$@"; exit $? ;; esac ;;
  status) case " $verb $* " in *" --server "*) exec bash "$here/ah-cli.sh" status ;; esac; exec node "$here/status.mjs" status ${verb:+"$verb"} "$@" ;;
  doctor) case " $verb $* " in *" --server "*) exec bash "$here/ah-cli.sh" doctor ;; esac; exec bash "$here/doctor.sh" ${verb:+"$verb"} "$@" ;;
  notify) exec node "$here/status.mjs" notify ${verb:+"$verb"} "$@" ;;
  setup) case "$verb" in sync) exec bash "$here/sync-commands.sh" "$@" ;; open) exec bash "$here/open-setup.sh" "$@" ;; *) usage ;; esac ;;
  habit) case "$verb" in ""|list|edit|clear) exec node "$here/habits.mjs" "${verb:-list}" "$@" ;; *) usage ;; esac ;;
  flow) case "$verb" in ""|show|list) srv "$@" ;; *) echo "/flow $verb needs the agent: run it inside grok/claude/codex." >&2; exit 2 ;; esac ;;
  security) srv "$@" ;;  # server decides; non-admins get the same help as an unknown command
  *) usage ;;
esac
